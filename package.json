{
  "name": "funnelchat-cli",
  "version": "0.1.0",
  "description": "CLI de Funnelchat para exportar conversaciones y contactos desde la API pública, y consultar números, plantillas y MACs",
  "license": "MIT",
  "author": {
    "name": "Funnelchat",
    "email": "soporte@funnelchat.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Funnelchat20/funnelchat-cli.git"
  },
  "homepage": "https://developers-portal.funnelchat.app/docs/",
  "bugs": {
    "url": "https://github.com/Funnelchat20/funnelchat-cli/issues",
    "email": "soporte@funnelchat.com"
  },
  "keywords": [
    "funnelchat",
    "whatsapp",
    "api",
    "cli",
    "export"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "funnelchat": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
